# Normalise line endings in the repository; files are checked out with the
# platform's native endings. The output comparison ignores CRLF versus LF.
* text=auto

# Shell scripts must keep LF line endings or Bash cannot run them, even when
# the repository is checked out on Windows; PowerShell scripts use CRLF.
*.sh text eol=lf
*.ps1 text eol=crlf
